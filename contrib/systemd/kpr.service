[Unit]
Description=kpr - Go Application Blueprint
Documentation=https://nrtn.dev/catalyst/kpr
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kpr
Group=kpr
ExecStart=/usr/local/bin/kpr serve
Restart=on-failure
RestartSec=5s

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/kpr

# Resource limits
LimitNOFILE=65536

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kpr

[Install]
WantedBy=multi-user.target
