{
  "title": "kpr demo (spike)",
  "uid": "kpr-demo-spike",
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "Request rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (path) (rate(kpr_http_server_requests_total[1m]))",
          "legendFormat": "{{path}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Demo queue depth (synthetic)",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "kpr_demo_queue_depth"
        }
      ]
    },
    {
      "id": 3,
      "title": "Latency p50 / p95",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, path) (rate(kpr_http_server_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p50 {{path}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, path) (rate(kpr_http_server_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 {{path}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Scrape health",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "up{job=\"kpr\"}"
        }
      ]
    }
  ],
  "schemaVersion": 41,
  "version": 1
}
